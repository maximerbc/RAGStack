# Copy to .env and add your real key only when you are ready for live API calls.
OPENAI_API_KEY=
OPENAI_GENERATION_MODEL=gpt-5.6-luna
OPENAI_REWRITE_MODEL=gpt-5.6-luna
OPENAI_JUDGE_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RERANKER_BACKEND=minilm
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
MODEL_CACHE_DIR=./.models
APP_DATA_DIR=./data
APP_HOST=127.0.0.1
APP_PORT=8000
MAX_FILE_MB=50
MAX_PDF_PAGES=500
